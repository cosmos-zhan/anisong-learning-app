{
  "name": "anisong-learning-app",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "node scripts/version.mjs && vite build",
    "typecheck": "node scripts/version.mjs && tsc --noEmit",
    "lint": "eslint apps packages tests",
    "test": "node scripts/version.mjs && vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:check",
    "prepare": "node scripts/version.mjs",
    "android:check": "node scripts/check-android.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@capacitor/core": "8.0.0",
    "@capacitor/android": "8.0.0",
    "opensheetmusicdisplay": "2.2.1",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19",
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "jsdom": "28.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@testing-library/jest-dom": "6.9.1",
    "eslint": "9.39.4",
    "typescript-eslint": "8.57.0",
    "fake-indexeddb": "6.2.5"
  }
}
